# Copy to ".env" and fill in. Works on any Docker host with Compose v2.

# Address under which the booking page is reached, without trailing slash.
BASE_URL=http://localhost:8090
APP_PORT=8090
LANGUAGE=english
TZ=Europe/Berlin

# Image to run. Pin a version (e.g. ...:sha-2570fd5) for reproducible installs.
# For a local build use: docker compose up -d --build
APP_IMAGE=ghcr.io/cup1dstunt/easyappointments:latest

# Generate each with: openssl rand -hex 32
DB_PASSWORD=
DB_ROOT_PASSWORD=
ENCRYPTION_KEY=
